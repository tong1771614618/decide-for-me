.profile-page {
  min-height: 100vh;
  padding: 32rpx 40rpx;
  padding-bottom: 40rpx;
  background: #FFF8F0;
}

/* ─── 用户卡片 ─── */

.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 32rpx;
}

/* ─── 头像 ─── */

.user-avatar-wrap {
  margin-bottom: 24rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
  width: auto;
}

.avatar-btn::after {
  display: none;
}

.avatar-btn--set {
  position: relative;
}

.avatar-default {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #F0EBE4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 4rpx dashed #D4C9BC;
}

.avatar-default-icon {
  font-size: 56rpx;
  line-height: 1;
}

.avatar-default-text {
  font-size: 20rpx;
  color: #B0A090;
}

.user-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #FF6B35;
}

/* ─── 昵称 ─── */

.user-name-section {
  margin-bottom: 28rpx;
}

.nickname-input {
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  min-width: 200rpx;
  padding: 0 16rpx;
}

.nickname-placeholder {
  font-size: 28rpx;
  color: #B0A090;
}

/* ─── 统计 ─── */

.user-stats {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 24rpx 40rpx;
  background: #FFF8F0;
  border-radius: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF6B35;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: #E8DDD0;
}

/* ─── 历史记录（可折叠） ─── */

.history-section {
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.history-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx;
}

.history-toggle-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.history-toggle-arrow {
  font-size: 24rpx;
  color: #B0A090;
  transition: transform 0.25s ease;
}

.history-toggle-arrow--up {
  transform: rotate(180deg);
}

/* 折叠内容 */
.history-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.history-body--show {
  max-height: 2000rpx;
}
