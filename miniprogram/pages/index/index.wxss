.page-container {
  min-height: 100vh;
  padding: 32rpx 40rpx;
  padding-bottom: 40rpx;
  background: #FFF8F0;
}

/* ─── 标题区 ─── */

.page-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 48rpx;
  gap: 12rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 300;
  color: #333333;
  letter-spacing: 12rpx;
  font-style: italic;
  font-family: 'PingFang SC', 'STKaiti', 'KaiTi', cursive, sans-serif;
}

.header-subtitle {
  font-size: 24rpx;
  color: #CCBBAA;
  letter-spacing: 2rpx;
  font-weight: 300;
}

/* ─── 玩法卡片网格 ─── */

.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

/* ─── 卡片 ─── */

.mode-card {
  width: calc(50% - 12rpx);
  height: 300rpx;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  position: relative;
  overflow: hidden;
}

.card-tap {
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.card-tap:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* ─── 卡片内容 ─── */

.card-emoji {
  font-size: 72rpx;
  line-height: 1;
}

.card-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.card-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
}

.card-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

/* ─── 卡片装饰圆 ─── */

.mode-card::after {
  content: '';
  position: absolute;
  right: -30rpx;
  bottom: -30rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
}
