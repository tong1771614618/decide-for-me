.coming-soon {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFF8F0;
  padding: 40rpx;
}

.cs-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.cs-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}

.cs-desc {
  font-size: 28rpx;
  color: #999999;
}
