.decide-btn-wrapper {
  padding: 32rpx 0 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.decide-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.2s ease;
}

.decide-btn--active {
  background: linear-gradient(135deg, #FF6B35, #FF8F5E);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.35);
}

.decide-btn--active:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.25);
}

.decide-btn--disabled {
  background: #E0E0E0;
  box-shadow: none;
}

.decide-btn-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.decide-btn--disabled .decide-btn-text {
  color: #AAAAAA;
}

.decide-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #FF8A80;
}
