.option-inputs {
  padding: 16rpx 0;
}

.option-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.option-number {
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #FFF0E8;
  color: #FF6B35;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-input {
  flex: 1;
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: #333333;
  border: 2rpx solid #EEEEEE;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: border-color 0.2s ease;
}

.option-input:focus {
  border-color: #FF6B35;
}

.option-input--disabled {
  opacity: 0.5;
  background: #F5F5F5;
}

.option-placeholder {
  color: #CCCCCC;
  font-size: 28rpx;
}
