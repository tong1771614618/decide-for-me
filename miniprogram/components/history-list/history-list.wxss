.history-section {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #F0EBE4;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.history-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.history-clear {
  font-size: 26rpx;
  color: #FF8A80;
  padding: 8rpx 16rpx;
}

/* ─── 空状态 ─── */

.history-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.history-empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.history-empty-text {
  font-size: 26rpx;
  color: #CCCCCC;
  text-align: center;
  line-height: 1.6;
}

/* ─── 记录卡片 ─── */

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.history-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.history-time {
  font-size: 22rpx;
  color: #BBBBBB;
}

.history-reroll {
  font-size: 22rpx;
  color: #FF6B35;
  background: #FFF0E8;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.history-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.history-option {
  font-size: 26rpx;
  color: #666666;
  background: #F5F5F5;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.history-option--picked {
  background: #FFF0E8;
  color: #FF6B35;
  font-weight: 600;
}

.history-result {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF6B35;
}
