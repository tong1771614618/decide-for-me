/* ─── 全屏遮罩 ─── */

.result-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
  animation: overlayFadeIn 0.3s ease;
}

@keyframes overlayFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ─── 结果弹窗卡片 ─── */

.result-card {
  width: 85%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 64rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  animation: cardPopIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  z-index: 2;
}

@keyframes cardPopIn {
  0% { opacity: 0; transform: scale(0.5) translateY(60rpx); }
  60% { opacity: 1; transform: scale(1.05) translateY(-10rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

/* ─── 趣味文案 ─── */

.result-copy {
  text-align: center;
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 24rpx;
  animation: copySlideIn 0.5s ease 0.2s both;
}

@keyframes copySlideIn {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ─── 结果文字（放大加粗） ─── */

.result-value {
  text-align: center;
  font-size: 80rpx;
  font-weight: 900;
  color: #FF6B35;
  padding: 20rpx 0;
  word-break: break-all;
  line-height: 1.3;
  text-shadow: 0 4rpx 8rpx rgba(255, 107, 53, 0.15);
  animation: valueBounceIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s both;
}

@keyframes valueBounceIn {
  0% { opacity: 0; transform: scale(0.3); }
  50% { opacity: 1; transform: scale(1.15); }
  70% { transform: scale(0.95); }
  100% { opacity: 1; transform: scale(1); }
}

/* ─── 装饰线 ─── */

.result-divider {
  width: 120rpx;
  height: 4rpx;
  background: linear-gradient(to right, transparent, #FFD5C0, transparent);
  margin: 24rpx 0 32rpx;
}

/* ─── 操作按钮 ─── */

.result-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.result-btn {
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  transition: all 0.2s ease;
}

.result-btn:active {
  transform: scale(0.96);
}

/* 就它了 - 主按钮 */
.result-btn--accept {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #7EC8A0, #5DB88C);
  color: #FFFFFF;
  font-size: 34rpx;
  box-shadow: 0 8rpx 24rpx rgba(126, 200, 160, 0.4);
  animation: btnSlideIn 0.4s ease 0.5s both;
}

/* 有点纠结再来一次 - 次按钮（缩小） */
.result-btn--reroll {
  width: auto;
  height: 64rpx;
  padding: 0 40rpx;
  background: transparent;
  color: #999999;
  font-size: 26rpx;
  font-weight: 400;
  border: 2rpx solid #E0E0E0;
  animation: btnSlideIn 0.4s ease 0.65s both;
}

.result-btn--disabled {
  opacity: 0.4;
  pointer-events: none;
}

@keyframes btnSlideIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ═══════════════════════════════════
   彩带粒子
   ═══════════════════════════════════ */

.confetti-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 1;
  overflow: hidden;
}

.confetti-piece {
  position: absolute;
  top: -20px;
  border-radius: 3rpx;
  animation-name: confettiFall;
  animation-timing-function: ease-in;
  animation-fill-mode: forwards;
}

@keyframes confettiFall {
  0% {
    opacity: 1;
    transform: translateY(0) rotate(0deg) scale(1);
  }
  20% {
    opacity: 1;
    transform: translateY(15vh) rotate(180deg) scale(0.9) translateX(20rpx);
  }
  40% {
    transform: translateY(35vh) rotate(360deg) scale(0.85) translateX(-15rpx);
  }
  60% {
    opacity: 0.8;
    transform: translateY(55vh) rotate(540deg) scale(0.7) translateX(25rpx);
  }
  80% {
    opacity: 0.5;
    transform: translateY(75vh) rotate(720deg) scale(0.5) translateX(-10rpx);
  }
  100% {
    opacity: 0;
    transform: translateY(100vh) rotate(900deg) scale(0.3);
  }
}
